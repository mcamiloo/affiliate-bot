<!DOCTYPE html>
<html lang="en">
<!-- Texto voltado pro público (Reino Unido) — inglês britânico de propósito (honour, organise, etc.), não americano. -->
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ site_title }}</title>
<style>
  @media only screen and (max-width: 620px) {
    .container { width: 100% !important; }
    .col-half { display: block !important; width: 100% !important; }
  }
</style>
</head>
<body style="margin:0; padding:0; background-color:#f5f6f8; font-family:-apple-system,Helvetica,Arial,sans-serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f5f6f8;">
  <tr>
    <td align="center" style="padding:24px 12px;">
      <table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0" style="width:600px; max-width:100%; background-color:#ffffff; border-radius:12px; overflow:hidden;">

        <tr>
          <td align="center" style="background:linear-gradient(90deg,#e0384a,#d9822b); padding:28px 20px;">
            <h1 style="margin:0; font-size:22px; color:#ffffff;">{{ site_title }}</h1>
            <p style="margin:6px 0 0; font-size:13px; color:#fff3ee;">{{ subtitle }}</p>
          </td>
        </tr>

        {% for offer in offers %}
        <tr>
          <td style="padding:16px 20px; border-bottom:1px solid #eceef2;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
              <tr>
                <td width="110" valign="top" style="padding-right:14px;">
                  {% if offer.image_url %}
                  <img src="{{ offer.image_url }}" alt="" width="100" style="display:block; border-radius:8px; width:100px; height:100px; object-fit:cover;">
                  {% else %}
                  <div style="width:100px; height:100px; background:#f0f1f4; border-radius:8px;"></div>
                  {% endif %}
                </td>
                <td valign="top">
                  <p style="margin:0 0 8px; font-size:14px; line-height:1.4; color:#14161c;">{{ offer.title }}</p>
                  <p style="margin:0 0 8px;">
                    <span style="font-size:17px; font-weight:700; color:#e0384a;">£{{ "%.2f"|format(offer.price) }}</span>
                    {% if offer.original_price and offer.original_price > offer.price %}
                    <span style="font-size:12px; color:#9aa1b2; text-decoration:line-through; margin-left:6px;">£{{ "%.2f"|format(offer.original_price) }}</span>
                    {% endif %}
                    {% if offer.discount_percent %}
                    <span style="font-size:11px; font-weight:700; color:#ffffff; background:#e0384a; padding:2px 6px; border-radius:999px; margin-left:6px;">-{{ offer.discount_percent | int }}%</span>
                    {% endif %}
                  </p>
                  <a href="{{ offer.affiliate_url }}" style="display:inline-block; font-size:13px; font-weight:700; color:#ffffff; background:#14161c; padding:8px 14px; border-radius:6px; text-decoration:none;">Grab the deal</a>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        {% endfor %}

        <tr>
          <td align="center" style="padding:20px;">
            <a href="{{ telegram_invite_link }}" style="display:inline-block; font-size:13px; font-weight:700; color:#14161c; border:1px solid #e4e6eb; padding:10px 18px; border-radius:999px; text-decoration:none;">Join us on Telegram for even more deals →</a>
          </td>
        </tr>

        <tr>
          <td style="padding:20px; background:#f0f1f4; font-size:11px; line-height:1.6; color:#5c6270;">
            Contains affiliate links — we may earn a commission on purchases made through them, at no extra cost to you.<br><br>
            {{ sender_name }} · {{ address_line1 }}, {{ address_city }}, {{ address_postal_code }}, {{ address_country }}<br>
            You're receiving this because you subscribed at our site and confirmed your email.
            <a href="{% raw %}{{ unsubscribe }}{% endraw %}" style="color:#5c6270;">Unsubscribe</a>
            ·
            {#- Link próprio (HMAC via UNSUB_TOKEN, ver utils/unsubscribe.py) além do
                {{ unsubscribe }} nativo do Brevo acima — os dois convivem de propósito,
                não é redundância à toa (ver project memory / decisão do usuário). #}
            <a href="{{ unsubscribe_base_url }}/newsletter/unsubscribe?email={% raw %}{{contact.EMAIL}}{% endraw %}&amp;token={% raw %}{{contact.UNSUB_TOKEN}}{% endraw %}" style="color:#5c6270;">Unsubscribe (alt.)</a>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>
</body>
</html>
