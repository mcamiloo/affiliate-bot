<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ site_title }}</title>
<meta name="description" content="{{ site_description }}">
<style>
  :root {
    color-scheme: light dark;
    --bg: #0b0d12;
    --surface: #151822;
    --surface-2: #1c202c;
    --text: #eef0f4;
    --text-muted: #9aa1b2;
    --accent: #ff5f6d;
    --accent-2: #ffc371;
    --border: #262b3a;
  }
  @media (prefers-color-scheme: light) {
    :root {
      --bg: #f5f6f8;
      --surface: #ffffff;
      --surface-2: #f0f1f4;
      --text: #14161c;
      --text-muted: #5c6270;
      --accent: #e0384a;
      --accent-2: #d9822b;
      --border: #e4e6eb;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
  }
  header {
    padding: 2.5rem 1.5rem 1.5rem;
    text-align: center;
  }
  header h1 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  header p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.1rem;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }
  .card.top-pick {
    border-color: var(--accent-2);
    box-shadow: 0 0 0 1px var(--accent-2), 0 8px 24px -8px color-mix(in srgb, var(--accent-2) 60%, transparent);
  }
  .top-pick-badge {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .card-image {
    aspect-ratio: 1 / 1;
    background: var(--surface-2);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card-image .placeholder {
    color: var(--text-muted);
    font-size: 2rem;
  }
  .badge {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    background: var(--accent);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
  }
  .card-body {
    padding: 0.85rem 0.9rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }
  .card-title {
    font-size: 0.88rem;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.4em;
  }
  .price-row {
    margin-top: auto;
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
  }
  .price {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--accent);
  }
  .price-original {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: line-through;
  }
  footer {
    text-align: center;
    padding: 2rem 1.5rem 3rem;
    color: var(--text-muted);
    font-size: 0.78rem;
    line-height: 1.6;
  }
  .empty-state {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--text-muted);
  }
</style>
</head>
<body>
<header>
  <h1>{{ site_title }}</h1>
  <p>{{ site_description }}</p>
</header>
<main>
  {% if offers %}
  <div class="grid">
    {% for offer in offers %}
    <a class="card{% if offer.score >= highlight_threshold %} top-pick{% endif %}" href="{{ offer.affiliate_url }}" target="_blank" rel="nofollow sponsored noopener">
      <div class="card-image">
        {% if offer.image_url %}
        <img src="{{ offer.image_url }}" alt="{{ offer.title }}" loading="lazy">
        {% else %}
        <span class="placeholder">🛒</span>
        {% endif %}
        {% if offer.discount_percent %}
        <span class="badge">-{{ offer.discount_percent | int }}%</span>
        {% endif %}
        {% if offer.score >= highlight_threshold %}
        <span class="top-pick-badge">🔥 Top pick</span>
        {% endif %}
      </div>
      <div class="card-body">
        <div class="card-title">{{ offer.title }}</div>
        <div class="price-row">
          <span class="price">£{{ "%.2f"|format(offer.price) }}</span>
          {% if offer.original_price and offer.original_price > offer.price %}
          <span class="price-original">£{{ "%.2f"|format(offer.original_price) }}</span>
          {% endif %}
        </div>
      </div>
    </a>
    {% endfor %}
  </div>
  {% else %}
  <div class="empty-state">No offers published yet.</div>
  {% endif %}
</main>
<footer>
  Contains affiliate links — we may earn a commission on purchases made through them, at no extra cost to you.<br>
  Generated on {{ generated_at }}.
</footer>
</body>
</html>
