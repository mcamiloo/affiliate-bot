# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA cometa o arquivo ".env" real em controle de versão.

# --- Mercado Livre (abandonado — referência histórica) ---
# API de catálogo/busca bloqueada pela plataforma desde 2026-08-01, ver
# memória do projeto / config.py para detalhes. Não usado ativamente.
# ML_CLIENT_ID=
# ML_CLIENT_SECRET=
# ML_ACCESS_TOKEN=
# ML_REFRESH_TOKEN=
# ML_AFFILIATE_TAG=

# --- AliExpress Affiliate API (Módulo 2) ---
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# --- Telegram (Módulo 4) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Regras de negócio ---
MIN_DISCOUNT_PERCENT=30
MAX_OFFERS_PER_KEYWORD=3

# --- Newsletter diária por email (Brevo) ---
BREVO_API_KEY=
# ID numérico da lista de contatos no Brevo pra onde vão os inscritos.
BREVO_LIST_ID=
# ID do template de double opt-in — criado manualmente no dashboard do
# Brevo (Campaigns > Templates > Double opt-in), não via API.
BREVO_DOI_TEMPLATE_ID=
# URL pra onde o Brevo redireciona depois do usuário confirmar o opt-in.
BREVO_DOI_REDIRECT_URL=https://ombrotechwear.co.uk/thank-you.html
BREVO_SENDER_NAME=OmbroTechFinds
BREVO_SENDER_EMAIL=mail@ombrotechwear.co.uk
# Segredo enviado pelo Brevo num header custom (X-Brevo-Webhook-Secret)
# em toda chamada do webhook de marketing — ver scripts/setup_brevo_webhook.py.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
BREVO_WEBHOOK_SECRET=
# Chave do HMAC do link de descadastro próprio (ver utils/unsubscribe.py)
# — PRECISA ser a mesma configurada como NEWSLETTER_UNSUB_SECRET nas env
# vars da Netlify (netlify/functions/subscribe.js usa a mesma chave).
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
NEWSLETTER_UNSUB_SECRET=
# URL pública de onde o painel é alcançável hoje (Tailscale Funnel, ou o
# proxy da Netlify em /sistema quando estiver no ar) — usada só pra
# montar o link de descadastro próprio no rodapé do email.
APPROVAL_PANEL_PUBLIC_URL=https://miguels-macbook-pro.tail598791.ts.net
# Pra onde o botão "Mandar teste" (fila de aprovação) manda a cópia de
# teste — deixe em branco pra cair no BREVO_SENDER_EMAIL mesmo.
NEWSLETTER_TEST_EMAIL=

# Endereço físico exigido por lei (PECR/CAN-SPAM) no rodapé do email.
NEWSLETTER_ADDRESS_LINE1="Crown Way"
NEWSLETTER_ADDRESS_CITY=Cardiff
NEWSLETTER_ADDRESS_POSTAL_CODE="CF14 3UZ"
NEWSLETTER_ADDRESS_COUNTRY="United Kingdom"

TELEGRAM_CHANNEL_INVITE_LINK=https://t.me/ombrotechfinds

# --- WhatsApp (Módulo 5 — automação de UI, sem API oficial) ---
# Requer o WhatsApp Desktop aberto e logado o tempo todo, e permissão de
# Acessibilidade concedida ao Python em Ajustes do Sistema > Privacidade e
# Segurança > Acessibilidade. Ver modules/whatsapp_publisher.py.
WHATSAPP_ENABLED=false
# Nome EXATO da comunidade/conversa como aparece no WhatsApp Desktop.
WHATSAPP_COMMUNITY_NAME=OmbroTechFinds

# Janela (hora local do Reino Unido) dentro da qual o horário de envio
# diário é sorteado aleatoriamente.
NEWSLETTER_WINDOW_START_HOUR_UK=8
NEWSLETTER_WINDOW_END_HOUR_UK=20
# Quanto tempo antes do horário sorteado o rascunho é gerado.
NEWSLETTER_DRAFT_LEAD_MINUTES=60
# Ofertas publicadas nas últimas N horas entram na seleção do dia.
NEWSLETTER_LOOKBACK_HOURS=48
NEWSLETTER_MAX_OFFERS=8

# Painel de aprovação — exige login (ver README). Acessível de fora via
# Tailscale Funnel + proxy da Netlify em /sistema.
APPROVAL_PANEL_PORT=8765
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
APPROVAL_PANEL_SECRET_KEY=
