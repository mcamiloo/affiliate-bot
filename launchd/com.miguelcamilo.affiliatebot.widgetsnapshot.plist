<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.miguelcamilo.affiliatebot.widgetsnapshot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/miguelcamilo/affiliate-bot/venv/bin/python3</string>
        <string>/Users/miguelcamilo/affiliate-bot/scripts/write_widget_snapshot.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/miguelcamilo/affiliate-bot</string>

    <!-- A cada 5min: bem mais curto que os 10min que o próprio WidgetKit
         pede pra próxima entry, pra a foto quase nunca estar velha quando
         o sistema decide renderizar. -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/miguelcamilo/affiliate-bot/logs/widgetsnapshot_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/miguelcamilo/affiliate-bot/logs/widgetsnapshot_stderr.log</string>
</dict>
</plist>
